# Copy this file to .env and fill in real keys:   cp .env.example .env
# .env is gitignored, so your keys never get committed.

# Exa — semantic web search. Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-api-key-here

# OpenRouter — one key for many LLMs. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: port for the local dev server (npm run dev). Defaults to 3000.
# PORT=3000
