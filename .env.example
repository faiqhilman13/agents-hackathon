# All keys are read by the local server and are never bundled in the extension.
# Confirmed default language-model provider: https://openrouter.ai/
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# Optional related-source search: https://exa.ai/
EXA_API_KEY=

# Local server configuration.
PORT=4317
# MARGIN_DATA_DIR=.data
